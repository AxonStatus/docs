{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "AxonStatus",
  "colors": {
    "primary": "#22c55e",
    "light": "#4ade80",
    "dark": "#16a34a"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": ["index", "quickstart", "authentication"]
          },
          {
            "group": "Core concepts",
            "pages": [
              "guides/status-pages",
              "guides/components",
              "guides/incidents",
              "guides/subscribers",
              "guides/monitoring",
              "guides/widget"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction",
              "api-reference/errors"
            ]
          },
          {
            "group": "Public",
            "pages": [
              "api-reference/public/status",
              "api-reference/public/widget",
              "api-reference/public/badge"
            ]
          },
          {
            "group": "Components",
            "pages": [
              "api-reference/components/list",
              "api-reference/components/create",
              "api-reference/components/update",
              "api-reference/components/delete"
            ]
          },
          {
            "group": "Incidents",
            "pages": [
              "api-reference/incidents/list",
              "api-reference/incidents/create",
              "api-reference/incidents/update",
              "api-reference/incidents/delete",
              "api-reference/incidents/add-update"
            ]
          },
          {
            "group": "Monitors",
            "pages": [
              "api-reference/monitors/list",
              "api-reference/monitors/create",
              "api-reference/monitors/update",
              "api-reference/monitors/delete"
            ]
          },
          {
            "group": "Subscribers",
            "pages": [
              "api-reference/subscribers/list",
              "api-reference/subscribers/subscribe",
              "api-reference/subscribers/delete"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Dashboard",
          "href": "https://axonstatus.com",
          "icon": "browser"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@axonstatus.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://axonstatus.com"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/axonstatus"
    }
  }
}
